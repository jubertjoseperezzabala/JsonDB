#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/media/jubert/Jubertssd/JsonDB/node_modules/.pnpm/react-docgen@5.4.3/node_modules/react-docgen/bin/node_modules:/media/jubert/Jubertssd/JsonDB/node_modules/.pnpm/react-docgen@5.4.3/node_modules/react-docgen/node_modules:/media/jubert/Jubertssd/JsonDB/node_modules/.pnpm/react-docgen@5.4.3/node_modules:/media/jubert/Jubertssd/JsonDB/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/media/jubert/Jubertssd/JsonDB/node_modules/.pnpm/react-docgen@5.4.3/node_modules/react-docgen/bin/node_modules:/media/jubert/Jubertssd/JsonDB/node_modules/.pnpm/react-docgen@5.4.3/node_modules/react-docgen/node_modules:/media/jubert/Jubertssd/JsonDB/node_modules/.pnpm/react-docgen@5.4.3/node_modules:/media/jubert/Jubertssd/JsonDB/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../react-docgen/bin/react-docgen.js" "$@"
else
  exec node  "$basedir/../react-docgen/bin/react-docgen.js" "$@"
fi
