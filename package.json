{
  "name": "jsondb-fluxer",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/JsonDB.js",
  "types": "./dist/JsonDB.d.ts",
  "exports": {
    ".": {
      "types": "./dist/JsonDB.d.ts",
      "import": "./dist/JsonDB.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --loader ts-node/esm --no-warnings apps/examples/SqlTest.ts",
    "jsondb": "tsx apps/examples/SqlTest.ts",
    "build": "tsc",
    "docs": "pnpm exec typedoc",
    "docs:watch": "pnpm exec typedoc --watch"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "better-docs": "^2.7.3",
    "docdash": "^2.0.2",
    "jsdoc": "^4.0.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.16",
    "typescript": "^5.9.3"
  }
}
